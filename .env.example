# Copy to .env and change before exposing Pulsewatch beyond localhost.
POSTGRES_PASSWORD=pulsewatch
# Shared secret agents use to authenticate (min 16 chars).
PULSEWATCH_AGENT_TOKEN=change-me-agent-token-0123456789
# Optional bearer token required for the REST API and dashboard data.
PULSEWATCH_API_TOKEN=
PULSEWATCH_RETENTION=168h
PULSEWATCH_PORT=8080
# Interface the dashboard/API is published on. Use 0.0.0.0 to expose it
# (set PULSEWATCH_API_TOKEN first).
PULSEWATCH_BIND=127.0.0.1
PULSEWATCH_LOG_LEVEL=info
